#!/bin/bash
echo "Выбери, что хочешь сделать"
echo "1 - поиск. 2 - редктирование. 3 - удаление"
read choice;
########################################
#                                      #
#если выбран поиск подтроки            #
#                                      #
########################################
if [[ "$choice" -eq 1 ]];
then
echo "Выбран поиск строки"
echo "Введи слово, кторое нужно найти"
read word;
echo "Введи файл"
read file;
 if grep -q "$word" "$file";
 then
 echo "Подстрока найдена"
 echo "Позиция"
 grep -ob "$word" "$file";
 echo "Слово и строка"
 grep -no "$word" "$file";
 else
 echo "Подстрока не найдена"
 fi
fi